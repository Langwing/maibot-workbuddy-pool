{
  "manifest_version": 2,
  "id": "local.workbuddy-pool",
  "version": "1.4.0",
  "name": "WorkBuddy 账号池接入",
  "description": "把 WorkBuddy（国内版/国际版）账号池接入 MaiBot：多账号导入与失败换号、模型目录（上下文/输出/倍率自动同步）、图片能力自动跟随上游、思考开关、积分总览、只读诊断、设备身份、批量测试，以及按目录对齐 model_config.toml 中本插件名下的模型。不含签到与福利/补偿领取。",
  "author": {
    "name": "local",
    "url": "https://github.com/Mai-with-u/MaiBot"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/dingminhua/dsh-connect-workbuddy",
    "homepage": "https://github.com/Langwing/maibot-workbuddy-pool"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9,<4"
    },
    {
      "type": "python_package",
      "name": "cryptography",
      "version_spec": ">=41"
    },
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.11"
    }
  ],
  "plugin_type": "provider",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "sparkles"
    }
  },
  "capabilities": [
    "send.text"
  ],
  "llm_providers": [
    {
      "client_type": "local.workbuddy-pool",
      "name": "WorkBuddy 账号池",
      "description": "通过 WorkBuddy 账号池转发的 OpenAI 兼容模型通道，支持多账号自动换号",
      "version": "1.4.0"
    }
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  }
}
